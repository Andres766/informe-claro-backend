# Variables de entorno (docker compose las lee de un archivo .env en esta carpeta).

# Proveedor de IA (API de terceros, por REST). Se usa Gemini si tiene key; si no, Claude.
# Sin ninguna key el servicio de interpretación funciona en "modo demo" (reglas).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Clave para firmar las sesiones (JWT): 32 caracteres o más. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Base de datos ÚNICA de los microservicios. Acepta postgres://usuario:clave@host:puerto/base
# (como la entregan Render, Neon o Supabase) o una URL jdbc:postgresql://...
# DATABASE_URL=postgresql://usuario:clave@host:5432/informeclaro

# Orígenes permitidos para el frontend, separados por comas (sin "/" al final)
CORS_ORIGINS=http://localhost:5173

# Idioma de las respuestas cuando el navegador no pide uno soportado: es | en
IDIOMA_POR_DEFECTO=es
