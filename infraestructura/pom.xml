<?xml version="1.0" encoding="UTF-8"?>
<!-- Infraestructura: orquestador. Expone la API REST al navegador y coordina los microservicios por gRPC. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>co.edu.ucc.informeclaro</groupId>
    <artifactId>informe-claro</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>infraestructura</artifactId>
  <name>InformeClaro · infraestructura (orquestador)</name>

  <dependencies>
    <dependency>
      <groupId>co.edu.ucc.informeclaro</groupId>
      <artifactId>contratos-grpc</artifactId>
    </dependency>
    <dependency>
      <groupId>co.edu.ucc.informeclaro</groupId>
      <artifactId>comun</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>infraestructura</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
